{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    // examples/ 按用户的写法 import 'leo-agents'；类型检查时指向源码，不依赖先构建出 dist（CI 先 typecheck 后 build）
    "paths": { "leo-agents": ["./src/index.ts"] }
  },
  "include": ["src", "test", "examples"]
}
