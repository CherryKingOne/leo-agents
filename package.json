{
  "name": "leo-agents",
  "version": "0.1.2",
  "description": "一切皆插件的可商用 TypeScript Agent 底座：插件内核 + 通用 Agent Loop + 开箱即用的 leo 命令行",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:basic": "node --experimental-strip-types examples/basic.ts",
    "example:plugin": "node --experimental-strip-types examples/custom-plugin.ts",
    "leo": "node dist/cli/main.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "bin": {
    "leo": "./dist/cli/main.js"
  }
}
